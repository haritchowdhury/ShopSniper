PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
# Optional migration fallback if the pooled DATABASE_URL cannot be used:
# DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
# Required in production. Use the same long random value in the frontend BFF.
BACKEND_API_TOKEN=
RUN_RATE_LIMIT_WINDOW_MS=60000
RUN_RATE_LIMIT_MAX=5
# Required only when intentionally creating frontend fixture data:
# FRONTEND_SEED_CONFIRM=non-production
# FRONTEND_SEED_OWNER_ID=the-neon-auth-user-id-that-will-view-the-fixture

INPUT_CSV=./data/categories.csv
OUTPUT_CSV=./data/leads.csv
GENERATED_QUERIES_CSV=./data/generated-queries.csv

GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

BROWSERLESS_URL=https://production-sfo.browserless.io/content
BROWSERLESS_TOKEN=
BROWSERLESS_FALLBACK_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_AI_NORMALIZATION=false
QUERY_GENERATION_MODEL=gpt-5.6-luna
QUERY_REASONING_EFFORT=low
QUERY_GENERATION_TIMEOUT_MS=120000
QUERY_MAX_OUTPUT_TOKENS=12000
WEB_SEARCH_CONTEXT_SIZE=medium

ENABLE_WEB_RESEARCH=true
RESEARCH_GEOGRAPHY=global English-language market
MAX_RESEARCH_SOURCES=8
GENERATED_QUERY_COUNT=10
QUERY_CANDIDATE_COUNT=25
QUERY_REPAIR_ROUNDS=2
QUERY_PROBE_CONCURRENCY=3
MIN_QUERY_RESULTS=5
MIN_QUERY_UNIQUE_HOSTS=4
MIN_QUERY_RELEVANT_RESULTS=2
MAX_SHOP_TYPES=100

GOOGLE_RESULTS_PER_QUERY=10
MAX_QUERIES=500
MAX_PAGES_PER_STORE=5
PAGE_FETCH_CONCURRENCY=2
STORE_CONCURRENCY=2
REQUEST_TIMEOUT_MS=20000
QUALIFICATION_THRESHOLD=45
MIN_RELEVANCE_SCORE=15
