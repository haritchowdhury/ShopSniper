{
  "name": "email-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lean AI-planned CSV-driven Shopify email scraper and lead generation server",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "run:once": "node src/run-once.js",
    "test": "node --test",
    "test:integration": "node -r dotenv/config --test --test-concurrency=1 test/*.integration.test.js",
    "check:secrets": "node scripts/check-secrets.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:frontend": "node src/seed-frontend.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.1",
    "google-auth-library": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
