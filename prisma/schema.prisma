generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunState {
  queued
  running
  awaiting_query_confirmation
  completed
  failed
  cancelled
}

enum RunPhase {
  query_planning
  query_review
  scraping
  finished
}

enum RunQuerySource {
  generated
  user_added
  user_edited
}

enum RunQueryValidationState {
  pending
  valid
  invalid
}

enum LeadStatus {
  qualified
  rejected
  failed
}

enum TrafficEnrichmentSource {
  dataforseo
  crux_rest
  crux_bigquery
}

enum TrafficEnrichmentCacheState {
  available
  no_coverage
}

enum LeadTrafficEnrichmentState {
  available
  partial
  no_coverage
  unavailable
  ambiguous
  contract_mismatch
}

enum DataForSeoRequestState {
  planned
  in_flight
  succeeded
  failed
  ambiguous
}

enum RunStoreState {
  discovered
  processing
  completed
  failed
}

enum RunExecutionBackend {
  local
  aws
}

enum PipelineStageName {
  discovery
  lead
  traffic_crux
}

enum PipelineStageState {
  collecting
  ready
  aggregating
  completed
  failed
  cancelled
}

enum PipelineTaskState {
  pending
  processing
  succeeded
  skipped
  failed
  cancelled
}

enum ShopLeadProfileState {
  processing
  completed
  failed
}

enum ShopWorkType {
  lead_discovery
  dataforseo
  crux_rest
  crux_bigquery
}

enum ShopWorkState {
  pending
  processing
  completed
  failed
  ambiguous
}

model Run {
  id                     String          @id
  ownerId                String?
  state                  RunState
  phase                  RunPhase        @default(query_planning)
  stage                  String
  normalizedShopTypes    Json
  createdAt              DateTime        @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  progress               Json
  resultsAvailable       Boolean         @default(false)
  leadSummary            Json?
  safeErrorCode          String?
  safeErrorMessage       String?
  pipelineVersion        Int?
  scoringVersion         Int?
  resultFingerprint      String?
  executionBackend       RunExecutionBackend @default(local)
  pipelineGeneration     Int                 @default(1)
  trafficEnrichmentConfig Json?
  awsProviderConfig       Json?
  trafficEnrichmentSummary Json?
  queryRevision          Int             @default(0)
  confirmedQueryRevision Int?
  queryPlanReadyAt       DateTime?
  queriesConfirmedAt     DateTime?
  leaseOwner             String?
  leaseToken             String?         @unique
  leaseAcquiredAt        DateTime?
  leaseExpiresAt         DateTime?
  lastHeartbeatAt        DateTime?
  leaseAttempt           Int             @default(0)
  leads                  Lead[]
  queryAudits            QueryAudit[]
  diagnostics            RunDiagnostic[]
  queries                RunQuery[]
  dataForSeoRequests     DataForSeoRequestLedger[]
  runStores              RunStore[]
  processingLeadProfiles ShopLeadProfile[] @relation("ShopLeadProfileProcessingRun")
  processingShopWork     ShopWork[] @relation("ShopWorkProcessingRun")
  userShopDiscoveries    UserShopDiscovery[]
  pipelineStages         PipelineStage[]

  @@index([state])
  @@index([state, leaseExpiresAt])
  @@index([createdAt])
  @@index([ownerId, createdAt])
}

model PipelineStage {
  id                        String             @id
  runId                     String
  run                       Run                @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage                     PipelineStageName
  generation                Int
  manifestS3Key             String
  manifestFingerprint       String
  manifestProducedAt        DateTime
  expectedCount             Int
  terminalCount             Int                @default(0)
  succeededCount            Int                @default(0)
  skippedCount              Int                @default(0)
  failedCount               Int                @default(0)
  cancelledCount            Int                @default(0)
  state                     PipelineStageState @default(collecting)
  version                   Int                @default(1)
  aggregationOwner          String?
  aggregationLeaseToken     String?            @unique
  aggregationLeaseAcquiredAt DateTime?
  aggregationLeaseExpiresAt DateTime?
  aggregationAttempt        Int                @default(0)
  safeErrorCode             String?
  safeErrorMessage          String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  completedAt               DateTime?
  tasks                     PipelineTask[]

  @@unique([runId, stage, generation])
  @@index([runId, generation])
  @@index([state, aggregationLeaseExpiresAt])
}

model PipelineTask {
  id                  String            @id
  stageId             String
  stage               PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  itemKey             String
  inputFingerprint    String
  state               PipelineTaskState @default(pending)
  attemptCount        Int               @default(0)
  dispatchCount       Int               @default(0)
  lastDispatchedAt    DateTime?
  leaseOwner          String?
  leaseToken          String?           @unique
  leaseAcquiredAt     DateTime?
  leaseExpiresAt      DateTime?
  leaseAttempt        Int               @default(0)
  artifactS3Key       String?
  artifactFingerprint String?
  terminalAt          DateTime?
  safeErrorCode       String?
  safeErrorMessage    String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([stageId, itemKey])
  @@index([stageId, state])
  @@index([state, leaseExpiresAt])
  @@index([stageId, lastDispatchedAt])
}

model RunQuery {
  id                   String                  @id
  runId                String
  run                  Run                     @relation(fields: [runId], references: [id], onDelete: Cascade)
  categoryIndex        Int
  sequence             Int
  query                String
  source               RunQuerySource
  validationState      RunQueryValidationState @default(pending)
  rejectionReason      String?
  queryScore           Float?
  generationReason     String?
  sourceUrls           String[]                @default([])
  categoryVocabulary   Json?
  probeSummary         Json?
  probeResults         Json?
  probeContractVersion String?
  probeFingerprint     String?
  probedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([runId, sequence])
  @@index([runId, categoryIndex, sequence])
  @@index([runId, validationState])
}

model RunIntent {
  id                  String   @id
  normalizedShopTypes Json
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  claimedByUserId     String?
  claimedRunId        String?  @unique

  @@index([expiresAt])
}

model Lead {
  id                    String     @id
  runId                 String
  run                   Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  shopId                String?
  shop                  Shop?      @relation("LeadShop", fields: [shopId], references: [id], onDelete: SetNull)
  shopLeadProfileId     String?
  shopLeadProfile       ShopLeadProfile? @relation(fields: [shopLeadProfileId], references: [shopId], onDelete: SetNull)
  shopType              String?
  originalShopType      String?
  businessQualifier     String?
  generatedQuery        String?
  queryScore            Float?
  queryGenerationReason String?
  searchQuery           String?
  googleRank            Int?
  googleResultUrl       String?
  myshopifyDomain       String?
  finalUrl              String?
  canonicalUrl          String?
  resolvedDomain        String?
  storeName             String?
  email                 String?
  emailSourceUrl        String?
  phone                 String?
  phoneSourceUrl        String?
  contactUrl            String?
  socialProfiles        String[]   @default([])
  additionalInformation String?
  shopifyConfidence     Int?
  relevanceScore        Int?
  leadScore             Int?
  pipelineVersion       Int?
  scoringVersion        Int?
  storeFitState         String?
  storeFitEvidence      Json?
  contactabilityTier    String?
  contactEvidence       Json?
  identityConfidence    Int?
  identityEvidence      Json?
  scoreBreakdown        Json?
  discoveryOccurrences  Json?
  matchedCategories     Json?
  status                LeadStatus
  rejectionReason       String?
  error                 String?
  trafficEnrichments    LeadTrafficEnrichment[]

  @@unique([id, runId])
  @@unique([runId, shopId])
  @@index([runId, status])
  @@index([runId, leadScore])
  @@index([runId, storeName])
  @@index([runId, shopType])
  @@index([runId, googleRank])
}

model Shop {
  id                 String   @id
  stableKey          String   @unique
  myshopifyDomain    String?
  resolvedDomain     String?
  canonicalUrl       String?
  identityConfidence Int?
  identityEvidence   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  runStores          RunStore[]
  leads              Lead[] @relation("LeadShop")
  leadProfile        ShopLeadProfile?
  work               ShopWork[]
  userShops          UserShop[]
}

model UserShop {
  id                   String   @id
  userId               String
  shopId               String
  shop                 Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  firstDiscoveredAt    DateTime
  lastDiscoveredAt     DateTime
  firstDiscoveredRunId String
  lastDiscoveredRunId  String
  discoveryCount       Int      @default(1)
  lifecycleStatus      String?
  notes                String?
  tags                 String[] @default([])
  archivedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  discoveries          UserShopDiscovery[]

  @@unique([userId, shopId])
  @@index([userId, lastDiscoveredAt])
  @@index([userId, lifecycleStatus])
  @@index([shopId])
}

model UserShopDiscovery {
  id           String   @id
  userShopId   String
  userShop     UserShop @relation(fields: [userShopId], references: [id], onDelete: Cascade)
  runId        String
  run          Run      @relation(fields: [runId], references: [id], onDelete: Restrict)
  leadId       String?
  discoveredAt DateTime
  createdAt    DateTime @default(now())

  @@unique([userShopId, runId])
  @@index([runId])
  @@index([userShopId, discoveredAt])
}

model RunStore {
  id               String        @id
  runId            String
  run              Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  shopId           String
  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  state            RunStoreState @default(discovered)
  candidatePayload Json
  safeErrorCode    String?
  safeErrorMessage String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([runId, shopId])
  @@index([runId, state])
  @@index([shopId])
}

model ShopLeadProfile {
  shopId           String               @id
  shop             Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  state            ShopLeadProfileState
  profilePayload   Json?
  processingRunId  String?
  processingRun    Run?                 @relation("ShopLeadProfileProcessingRun", fields: [processingRunId], references: [id], onDelete: SetNull)
  safeErrorCode    String?
  safeErrorMessage String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  leads            Lead[]

  @@index([state, processingRunId])
}

model ShopWork {
  id                   String        @id
  shopId               String
  shop                 Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  workType             ShopWorkType
  scopeKey             String
  state                ShopWorkState @default(pending)
  processingRunId      String?
  processingRun        Run?          @relation("ShopWorkProcessingRun", fields: [processingRunId], references: [id], onDelete: SetNull)
  processingLeaseToken String?
  processingPipelineTaskId String?
  safeErrorCode        String?
  safeErrorMessage     String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([shopId, workType, scopeKey])
  @@index([state, processingRunId])
  @@index([processingPipelineTaskId])
}

model TrafficEnrichmentCache {
  id                String                      @id
  source            TrafficEnrichmentSource
  identity          String
  scopeKey          String
  metricSetKey      String
  contractVersion   String
  state             TrafficEnrichmentCacheState
  normalizedPayload Json?
  fetchedAt         DateTime
  coverageStartedAt DateTime?
  coverageEndedAt   DateTime?
  expiresAt         DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([source, identity, scopeKey, metricSetKey, contractVersion])
  @@index([expiresAt])
  @@index([source, identity, scopeKey])
}

model LeadTrafficEnrichment {
  id                String                     @id
  runId             String
  leadId            String
  lead              Lead                       @relation(fields: [leadId, runId], references: [id, runId], onDelete: Cascade)
  source            TrafficEnrichmentSource
  state             LeadTrafficEnrichmentState
  contractVersion   String
  normalizedPayload Json?
  fetchedAt         DateTime?
  coverageStartedAt DateTime?
  coverageEndedAt   DateTime?
  createdAt         DateTime                   @default(now())

  @@unique([leadId, source])
  @@index([runId, source])
}

model DataForSeoRequestLedger {
  requestFingerprint String                 @id
  runId              String
  run                Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetCount        Int
  scopeKey           String
  state              DataForSeoRequestState @default(planned)
  attempt            Int                    @default(0)
  safeErrorCode      String?
  safeErrorMessage   String?
  reservationCostUsd Decimal?               @db.Decimal(18, 8)
  providerCostUsd    Decimal?               @db.Decimal(18, 8)
  resultFingerprint  String?
  leaseOwner         String?
  leaseToken         String?
  leaseAttempt       Int?
  plannedAt          DateTime               @default(now())
  claimedAt          DateTime?
  ambiguousAfter     DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([runId, state])
  @@index([state, ambiguousAfter])
}

model QueryAudit {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  shopType          String?
  businessQualifier String?
  query             String?
  status            String
  rejectionReason   String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, status])
}

model RunDiagnostic {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  scope             String
  code              String
  shopType          String?
  businessQualifier String?
  query             String?
  resultUrl         String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, scope, code])
}
