generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunState {
  queued
  running
  awaiting_query_confirmation
  completed
  failed
  cancelled
}

enum RunPhase {
  query_planning
  query_review
  scraping
  finished
}

enum RunQuerySource {
  generated
  user_added
  user_edited
}

enum RunQueryValidationState {
  pending
  valid
  invalid
}

enum LeadStatus {
  qualified
  rejected
  failed
}

model Run {
  id                     String          @id
  ownerId                String?
  state                  RunState
  phase                  RunPhase        @default(query_planning)
  stage                  String
  normalizedShopTypes    Json
  createdAt              DateTime        @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  progress               Json
  resultsAvailable       Boolean         @default(false)
  leadSummary            Json?
  safeErrorCode          String?
  safeErrorMessage       String?
  pipelineVersion        Int?
  scoringVersion         Int?
  resultFingerprint      String?
  queryRevision          Int             @default(0)
  confirmedQueryRevision Int?
  queryPlanReadyAt       DateTime?
  queriesConfirmedAt     DateTime?
  leaseOwner             String?
  leaseToken             String?         @unique
  leaseAcquiredAt        DateTime?
  leaseExpiresAt         DateTime?
  lastHeartbeatAt        DateTime?
  leaseAttempt           Int             @default(0)
  leads                  Lead[]
  queryAudits            QueryAudit[]
  diagnostics            RunDiagnostic[]
  queries                RunQuery[]

  @@index([state])
  @@index([state, leaseExpiresAt])
  @@index([createdAt])
  @@index([ownerId, createdAt])
}

model RunQuery {
  id                   String                  @id
  runId                String
  run                  Run                     @relation(fields: [runId], references: [id], onDelete: Cascade)
  categoryIndex        Int
  sequence             Int
  query                String
  source               RunQuerySource
  validationState      RunQueryValidationState @default(pending)
  rejectionReason      String?
  queryScore           Float?
  generationReason     String?
  sourceUrls           String[]                @default([])
  categoryVocabulary   Json?
  probeSummary         Json?
  probeResults         Json?
  probeContractVersion String?
  probeFingerprint     String?
  probedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([runId, sequence])
  @@index([runId, categoryIndex, sequence])
  @@index([runId, validationState])
}

model RunIntent {
  id                  String   @id
  normalizedShopTypes Json
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  claimedByUserId     String?
  claimedRunId        String?  @unique

  @@index([expiresAt])
}

model Lead {
  id                    String     @id
  runId                 String
  run                   Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  shopType              String?
  originalShopType      String?
  businessQualifier     String?
  generatedQuery        String?
  queryScore            Float?
  queryGenerationReason String?
  searchQuery           String?
  googleRank            Int?
  googleResultUrl       String?
  myshopifyDomain       String?
  finalUrl              String?
  canonicalUrl          String?
  resolvedDomain        String?
  storeName             String?
  email                 String?
  emailSourceUrl        String?
  phone                 String?
  phoneSourceUrl        String?
  contactUrl            String?
  socialProfiles        String[]   @default([])
  additionalInformation String?
  shopifyConfidence     Int?
  relevanceScore        Int?
  leadScore             Int?
  pipelineVersion       Int?
  scoringVersion        Int?
  storeFitState         String?
  storeFitEvidence      Json?
  contactabilityTier    String?
  contactEvidence       Json?
  identityConfidence    Int?
  identityEvidence      Json?
  scoreBreakdown        Json?
  discoveryOccurrences  Json?
  matchedCategories     Json?
  status                LeadStatus
  rejectionReason       String?
  error                 String?

  @@index([runId, status])
  @@index([runId, leadScore])
  @@index([runId, storeName])
  @@index([runId, shopType])
  @@index([runId, googleRank])
}

model QueryAudit {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  shopType          String?
  businessQualifier String?
  query             String?
  status            String
  rejectionReason   String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, status])
}

model RunDiagnostic {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  scope             String
  code              String
  shopType          String?
  businessQualifier String?
  query             String?
  resultUrl         String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, scope, code])
}
