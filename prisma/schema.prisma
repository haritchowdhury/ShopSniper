generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunState {
  queued
  running
  awaiting_query_confirmation
  completed
  failed
  cancelled
}

enum RunPhase {
  query_planning
  query_review
  scraping
  finished
}

enum RunQuerySource {
  generated
  user_added
  user_edited
}

enum RunQueryValidationState {
  pending
  valid
  invalid
}

enum LeadStatus {
  qualified
  rejected
  failed
}

enum TrafficEnrichmentSource {
  dataforseo
  crux_rest
  crux_bigquery
}

enum TrafficEnrichmentCacheState {
  available
  no_coverage
}

enum LeadTrafficEnrichmentState {
  available
  partial
  no_coverage
  unavailable
  ambiguous
  contract_mismatch
}

enum DataForSeoRequestState {
  planned
  in_flight
  succeeded
  failed
  ambiguous
}

model Run {
  id                     String          @id
  ownerId                String?
  state                  RunState
  phase                  RunPhase        @default(query_planning)
  stage                  String
  normalizedShopTypes    Json
  createdAt              DateTime        @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  progress               Json
  resultsAvailable       Boolean         @default(false)
  leadSummary            Json?
  safeErrorCode          String?
  safeErrorMessage       String?
  pipelineVersion        Int?
  scoringVersion         Int?
  resultFingerprint      String?
  trafficEnrichmentConfig Json?
  trafficEnrichmentSummary Json?
  queryRevision          Int             @default(0)
  confirmedQueryRevision Int?
  queryPlanReadyAt       DateTime?
  queriesConfirmedAt     DateTime?
  leaseOwner             String?
  leaseToken             String?         @unique
  leaseAcquiredAt        DateTime?
  leaseExpiresAt         DateTime?
  lastHeartbeatAt        DateTime?
  leaseAttempt           Int             @default(0)
  leads                  Lead[]
  queryAudits            QueryAudit[]
  diagnostics            RunDiagnostic[]
  queries                RunQuery[]
  dataForSeoRequests     DataForSeoRequestLedger[]

  @@index([state])
  @@index([state, leaseExpiresAt])
  @@index([createdAt])
  @@index([ownerId, createdAt])
}

model RunQuery {
  id                   String                  @id
  runId                String
  run                  Run                     @relation(fields: [runId], references: [id], onDelete: Cascade)
  categoryIndex        Int
  sequence             Int
  query                String
  source               RunQuerySource
  validationState      RunQueryValidationState @default(pending)
  rejectionReason      String?
  queryScore           Float?
  generationReason     String?
  sourceUrls           String[]                @default([])
  categoryVocabulary   Json?
  probeSummary         Json?
  probeResults         Json?
  probeContractVersion String?
  probeFingerprint     String?
  probedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([runId, sequence])
  @@index([runId, categoryIndex, sequence])
  @@index([runId, validationState])
}

model RunIntent {
  id                  String   @id
  normalizedShopTypes Json
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  claimedByUserId     String?
  claimedRunId        String?  @unique

  @@index([expiresAt])
}

model Lead {
  id                    String     @id
  runId                 String
  run                   Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  shopType              String?
  originalShopType      String?
  businessQualifier     String?
  generatedQuery        String?
  queryScore            Float?
  queryGenerationReason String?
  searchQuery           String?
  googleRank            Int?
  googleResultUrl       String?
  myshopifyDomain       String?
  finalUrl              String?
  canonicalUrl          String?
  resolvedDomain        String?
  storeName             String?
  email                 String?
  emailSourceUrl        String?
  phone                 String?
  phoneSourceUrl        String?
  contactUrl            String?
  socialProfiles        String[]   @default([])
  additionalInformation String?
  shopifyConfidence     Int?
  relevanceScore        Int?
  leadScore             Int?
  pipelineVersion       Int?
  scoringVersion        Int?
  storeFitState         String?
  storeFitEvidence      Json?
  contactabilityTier    String?
  contactEvidence       Json?
  identityConfidence    Int?
  identityEvidence      Json?
  scoreBreakdown        Json?
  discoveryOccurrences  Json?
  matchedCategories     Json?
  status                LeadStatus
  rejectionReason       String?
  error                 String?
  trafficEnrichments    LeadTrafficEnrichment[]

  @@unique([id, runId])
  @@index([runId, status])
  @@index([runId, leadScore])
  @@index([runId, storeName])
  @@index([runId, shopType])
  @@index([runId, googleRank])
}

model TrafficEnrichmentCache {
  id                String                      @id
  source            TrafficEnrichmentSource
  identity          String
  scopeKey          String
  metricSetKey      String
  contractVersion   String
  state             TrafficEnrichmentCacheState
  normalizedPayload Json?
  fetchedAt         DateTime
  coverageStartedAt DateTime?
  coverageEndedAt   DateTime?
  expiresAt         DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([source, identity, scopeKey, metricSetKey, contractVersion])
  @@index([expiresAt])
  @@index([source, identity, scopeKey])
}

model LeadTrafficEnrichment {
  id                String                     @id
  runId             String
  leadId            String
  lead              Lead                       @relation(fields: [leadId, runId], references: [id, runId], onDelete: Cascade)
  source            TrafficEnrichmentSource
  state             LeadTrafficEnrichmentState
  contractVersion   String
  normalizedPayload Json?
  fetchedAt         DateTime?
  coverageStartedAt DateTime?
  coverageEndedAt   DateTime?
  createdAt         DateTime                   @default(now())

  @@unique([leadId, source])
  @@index([runId, source])
}

model DataForSeoRequestLedger {
  requestFingerprint String                 @id
  runId              String
  run                Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  targetCount        Int
  scopeKey           String
  state              DataForSeoRequestState @default(planned)
  attempt            Int                    @default(0)
  safeErrorCode      String?
  safeErrorMessage   String?
  providerCostUsd    Decimal?               @db.Decimal(18, 8)
  leaseOwner         String?
  leaseToken         String?
  leaseAttempt       Int?
  plannedAt          DateTime               @default(now())
  claimedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([runId, state])
  @@index([state, claimedAt])
}

model QueryAudit {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  shopType          String?
  businessQualifier String?
  query             String?
  status            String
  rejectionReason   String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, status])
}

model RunDiagnostic {
  id                String  @id
  runId             String
  run               Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence          Int
  scope             String
  code              String
  shopType          String?
  businessQualifier String?
  query             String?
  resultUrl         String?
  details           Json

  @@unique([runId, sequence])
  @@index([runId, scope, code])
}
